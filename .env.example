# ─────────────────────────────────────────────────────────────
# Email delivery (Resend) — powers the Contact & Booking forms.
# Without these, submissions are validated and logged server-side
# instead of emailed, so the site still works everywhere.
# ─────────────────────────────────────────────────────────────

# Your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are delivered (defaults to the site email).
CONTACT_TO_EMAIL=info@idealdrivingschooldallas.com

# Verified sender. In Resend test mode use onboarding@resend.dev;
# for production, verify your domain and use e.g. hello@idealdrivingschooldallas.com
CONTACT_FROM_EMAIL="Ideal Driving School <onboarding@resend.dev>"
